# Copy to .env and fill in. The API service reads these; they are never sent to
# the browser and never appear in a request from it.
#
# Anything already exported in your shell wins over this file.

# Incident advisor. Without a key the agent still detects, decides, guards and
# measures; it just runs without written commentary, and the desk says so.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Read-only Razorpay test mode intake. Optional. Test mode only.
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
RAZORPAY_MERCHANT_ID=
